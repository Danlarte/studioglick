---
const { title } = Astro.props;
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
  </head>
  <body>
    <header>
    
    </header>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
   
  }
  
  body {
    margin-top: 160px;
  }

  main {
    margin: 3rem auto;
    width: min(54ch, 90%);
  }

 
  h1{
    margin-top: 150px;
    font-size: x-large;
  }
  h2 {
    color: #cc0fd6;
    line-height: 1.1;
    font-size: large;
   
  }
  img {
    width: 100%;
  }


  .post-preview{
    border-radius: 20px;
  

  }
  

  .post-preview h2  {
    color: inherit;
    text-decoration: none;
    margin: 25px;
  }

  .post-preview p  {
   margin: 25px;
  }

a.nextpost{
  margin: 25px;
  color: #cc0fd6;
 }

 

  article.post-preview{
    background-color: #d4ff2a;
    margin-top: 90px;
    margin-bottom: 90px;
    
    
  }

  .hero {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  height: 100vh; /* Ajusta la altura del héroe según necesites */
  width: 100; /* Limita el ancho máximo del héroe */
  margin: 0 auto; /* Centra el héroe en la página */
  padding: 2rem;

  /* Imagen de fondo */
  background-image: url('https://images.unsplash.com/photo-1627158191866-aa70f2100d55?q=80&w=3270&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'); /* Cambia esta URL por tu imagen */
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  color: white; /* Asegura que el texto sea legible */
  border-radius: 12px; /* Bordes redondeados opcionales */
}

.hero-content {
  background: rgba(0, 0, 0, 0.6); /* Fondo oscuro para el texto */
  padding: 1.5rem;
  border-radius: 8px;
}

.hero h1 {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

.hero p {
  font-size: 1.25rem;
}

  

</style>

---
import  "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import '@fontsource/livvic/300.css';
import '@fontsource/livvic/400.css';
import '@fontsource/livvic/500.css';

const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    
    <meta charset="UTF-8" />
    <meta name="description" content="Studio Glick" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/node_modules/@fontsource/livvic/files/font.woff2" as="font" type="font/woff2" crossorigin="anonymous">

    <title>{title}</title>
  </head>


  <body>
    
    
    <Navbar />
    
    <slot />
    <Footer/>
  </body>


  
</html>

<style>
    * {
      box-sizing: border-box;
    }
   
    body {
      margin: 20px;
      justify-content: center;
    }

    img {
      width: 100%;
    }
  
    .post-preview h2 {
      margin-top: 3rem;
      margin-bottom: 0;
    }
  
    .post-preview h2 a {
      color: inherit;
      text-decoration: none;
      
    }
  
    .byline {
      color: #131313;
      font-size: 0.875rem;
      font-style: italic;
    }
  </style>


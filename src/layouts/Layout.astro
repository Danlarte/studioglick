---
import "../styles/global.css";
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import '@fontsource/livvic/300.css';
import '@fontsource/livvic/400.css';
import '@fontsource/livvic/700.css';
import { getDict, getLocale, locales, withLocale } from '../i18n';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const locale = getLocale(Astro.url);
const t = getDict(locale);
const alternates = locales.map(
  (l) => new URL(withLocale(Astro.url.pathname, l), Astro.url.origin).href
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {locales.map((l, i) => (
      <link rel="alternate" hreflang={l} href={alternates[i]} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0]} />

  <ViewTransitions />
  </head>
  <body class="bg-gray-950 font-Livvic">
    <Navbar />
    <slot />
    <Footer/>
  </body>
</html>

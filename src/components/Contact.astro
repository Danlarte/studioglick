---
import Container from "./Container.astro"
import Topic from "./Topic.astro";
import { getDict, getLocale } from "../i18n";

const t = getDict(getLocale(Astro.url));

const socials = [
    { href: "https://www.linkedin.com/company/studioglick", icon: "/team/linkedin.svg", label: "LinkedIn" },
    { href: "https://wa.me/549381090605", icon: "/team/whatsapp.svg", label: "WhatsApp" },
    { href: "mailto:studioglick@gmail.com", icon: "/team/mail.svg", label: "Email" },
];
---
<Container>

<section id="contactame">

    <div class="relative flex flex-col items-center md:flex-row" >
    <Topic title={t.contact.title} description={t.contact.description} />
</div>

<div class="formulary relative flex flex-col items-center my-6 rounded-[25px] py-16 px-6">
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14">
        {socials.map(({ href, icon, label }) => (
            <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class="group">
                <span class="flex h-20 w-20 md:h-24 md:w-24 items-center justify-center rounded-full bg-white shadow-sm transition duration-300 group-hover:-translate-y-1.5 group-hover:shadow-md">
                    <img src={icon} alt={`${t.contact.altSocial} - ${label}`} class="h-10 w-10 md:h-12 md:w-12" />
                </span>
            </a>
        ))}
    </div>
    <p class="mt-10 text-center text-xl">{t.contact.ctaLine1} <br> {t.contact.ctaLine2}</p>
</div>
</section>
</Container>

<style>
    .formulary{
        background-color: #f4bee9;
    }
</style>

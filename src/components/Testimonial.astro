---
import Container from "./Container.astro"
import Topic from "./Topic.astro"
import SwiperSlider from "./SwiperSlider.astro";
import { getDict, getLocale } from "../i18n";

const t = getDict(getLocale(Astro.url));
---
<Container>
<div class="relative flex flex-col items-center md:flex-row">
    <Topic title={t.testimonials.title} description={t.testimonials.description} />
</div>

<div class="rounded-[45px] bg-black mb-[150px] text-white">
    <SwiperSlider />
</div>

</Container>
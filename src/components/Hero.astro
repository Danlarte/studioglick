---
import Container from "./Container.astro"
import '@fontsource/livvic/300.css';
import '@fontsource/livvic/400.css';
import '@fontsource/livvic/700.css';
import { getDict, getLocale, withLocale } from "../i18n";

const t = getDict(getLocale(Astro.url));
const locale = getLocale(Astro.url);
---


<Container>
<div class="relative flex flex-col items-center md:flex-row pt-14" id="hero" >
    <div class="row items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
        <div class="text-left space-y-5">
            <p class="text-xs md:text-sm font-normal uppercase tracking-[0.2em] text-center md:text-left">{t.hero.eyebrow}</p>
            <h1 class="text-5xl font-medium leading-none md:text-6xl text-center md:text-left">{t.hero.title1}<br> {t.hero.title2}</h1>
            <h2 class="text-2xl md:text-3xl font-normal leading-8 text-center md:text-left">{t.hero.subtitle}</h2>
            <p class="text-lg font-light leading-7 max-w-[36rem] text-center md:text-left">{t.hero.description}</p>
            <div class="flex flex-col sm:flex-row justify-center md:justify-start items-center gap-4 pt-2">
                <a href={withLocale("/#contactame", locale)} class="w-full sm:w-auto px-8 py-5 bg-zinc-900 hover:bg-white rounded-2xl text-center text-white hover:text-black border text-xl font-normal leading-7">{t.hero.cta}
                </a>
                <a href={withLocale("/#proyectos", locale)} class="w-full sm:w-auto px-8 py-5 bg-white hover:bg-zinc-900 rounded-2xl text-center text-black hover:text-white border text-xl font-normal leading-7">{t.hero.ctaSecondary}
                </a>
            </div>
        </div>
    </div>
    <div class="flex items-center py-5 md:w-6/12 md:pb-20 md:pt-10 lg:ml-12">
        <img src="/frontWeb.svg" width="100%" alt={t.hero.alt}/>
    </div>
</div>


<div class="slider overflow-hidden w-[100%] mx-auto">
    <div class="slide-track flex animate-scroll w-[calc(50px_*_16)]">
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/branding.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/contenidos.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/creatividad.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/disenioWeb.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/identidad.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/ilustraciones.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/tiendaonline.svg" alt={t.hero.slideAlt}>
      </div>

      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/branding.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/contenidos.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/creatividad.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/disenioWeb.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/identidad.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/ilustraciones.svg" alt={t.hero.slideAlt}>
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="/clients/tiendaonline.svg" alt={t.hero.slideAlt}>
      </div>

      </div>
    </div>
  </div>
  
</Container>


---
import Container from "./Container.astro"
import '@fontsource/livvic/300.css';
import '@fontsource/livvic/400.css';
import '@fontsource/livvic/700.css';
---




<Container>
<div class="relative flex flex-col-reverse items-center md:flex-row pt-14" id="hero" >
    <div class="row items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
        <div class="text-left space-y-3">
            <h1 class="text-5xl font-medium leading-none md:text-6xl text-center md:text-left">Efervescencia<br> Creativa</h1>
            <p class="mt-6 mb-4  text-xl font-normal leading-7 sm:mb-12 text-center md:text-left">En Studio Glick , somos un equipo apasionado de diseñadores y desarrolladores dedicados a convertir tus ideas en realidades visuales y digitales. Nuestra misión es ofrecer soluciones creativas y personalizadas que impulsen el éxito de tu marca</p>
            <div id="custom-font" class="w-full justify-center md:justify-start items-center inline-flex mt-4">
                <a href="https://Contact" target="_blank" class="px-8 py-5 bg-zinc-900 hover:bg-white rounded-2xl text-center text-white hover:text-black border text-xl font-normal leading-7">¡Estamos aquí para escucharte!
                </a>
            </div>
        </div>
    </div>
    <div class="flex items-center py-5 md:w-6/12 md:pb-20 md:pt-10 lg:ml-12">
        <img src="/frontWeb.svg" width="100%" alt="Hero"/>
    </div>
</div>


<div class="slider overflow-hidden w-[100%] mx-auto">
    <div class="slide-track flex animate-scroll w-[calc(50px_*_16)]">
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/branding.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/contenidos.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/creatividad.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/disenioWeb.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/identidad.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/ilustraciones.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/tiendaonline.svg" alt="Slide image">
      </div>

      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/branding.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/contenidos.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/creatividad.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/disenioWeb.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/identidad.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/ilustraciones.svg" alt="Slide image">
      </div>
      <div class="slide w-[200px]">
        <img class="w-full" src="./clients/tiendaonline.svg" alt="Slide image">
      </div>

      </div>
    </div>
  </div>
  
</Container>


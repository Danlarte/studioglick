---
import Container from "./Container.astro"
import Topic from "./Topic.astro";
import servicesData from './Data/services.json';
import '@fontsource/livvic/300.css';
import '@fontsource/livvic/400.css';
import '@fontsource/livvic/700.css';
import { getDict, getLocale, withLocale } from "../i18n";

const locale = getLocale(Astro.url);
const t = getDict(locale);

const services = servicesData.map((item) => {
  const text = t.services.items.find((i) => i.id === item.id);
  return {
    ...item,
    title: text?.title ?? "",
    description: text?.description ?? "",
    metaLabel: text?.metaLabel ?? "",
    meta: text?.meta ?? "",
  };
});
---
<Container>
<section id="servicios" >   
<div class="relative flex flex-col items-center md:flex-row">
    <Topic title={t.services.title} description={t.services.description}>
</div>

<div class="flex-row items-center gap-4 mt-18 mb-8 py-5 ">
    <div class="grid grid-cols-1 sm:grid-cols-1 md:grid-cols-2 gap-8">

        <!-- card start-->
        {
        services.map(({ background, title, description, metaLabel, meta, arrow, link, image} ) => (
        <div class={background}>
            <div class="flex flex-col justify-between gap-10 self-stretch">
                <div class="flex flex-col gap-5">
                    <h3 class="text-3xl font-medium">
                        <span class="px-3 py-1 bg-lime-300 rounded-[7px]">{title}</span>
                    </h3>
                    <p class="text-lg font-normal leading-7 max-w-[28rem]">{description}</p>
                    <p class="text-sm font-light leading-6 max-w-[28rem]">
                        <span class="font-normal">{metaLabel}:</span> {meta}
                    </p>
                </div>
                <a class="justify-start items-center gap-[15px] inline-flex" href={withLocale(link, locale)}>
                    <div class="w-[41px] h-[41px] relative">
                        <img class="w-[41px] h-[41px] left-6 top-0  absolute" src={arrow} alt="" />
                    </div>
                    <div class="text-xl font-normal leading-7 ml-6">{t.services.cta}</div>
                </a>
            </div>
            <div class="hidden md:flex w-[210px] h-[170px] pt-0.5 pb-[1.95px] justify-center items-center shrink-0 ml-8">
                <img src={image} alt="" />
            </div>
        </div>
        ))
        }
        <!-- card end-->
         
    </div>
    
</div>

<div class="flex-row items-center my-6 p-14 bg-gray-950 rounded-[45px]">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="justify-start items-center gap-[275px] flex">
            <div class="flex-col justify-start items-start gap-[26px] inline-flex text-black">
                <div id="custom-font" class="text-3xl font-medium">{t.services.promoTitle}</div>
                <div class="text-lg font-normal">{t.services.promoText}</div>
                <a href="/" class="px-[35px] py-5 bg-zinc-900 hover:bg-white text-white hover:text-black border rounded-[14px] justify-start items-start gap-2.5 inline-flex">
                    <div   id="custom-font" class="text-center text-xl font-normal leading-7">{t.services.promoCta}</div>
                </a>
            </div>
        </div>
        <div class="hidden md:grid justify-items-center -m-20 mt-6">
            <img src="/services/refrescoWeb.svg" width="70%" alt={t.services.alt} />
        </div>
    </div>
</div>

</section> 
</Container>


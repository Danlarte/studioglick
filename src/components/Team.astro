---
import Container from "./Container.astro"
import Topic from "./Topic.astro";
import teamData from './Data/team.json';
import Accordion from "./Accordion.astro";
import '@fontsource/livvic/300.css';
import '@fontsource/livvic/400.css';
import '@fontsource/livvic/700.css';
import { getDict, getLocale } from "../i18n";

const t = getDict(getLocale(Astro.url));

const deliverables = teamData.team.map((asset, i) => ({
  ...asset,
  ...t.deliverables.items[i],
}));

---
<Container>

<section id="procesos" >   
<div class="relative flex flex-col items-center md:flex-row">
    <Topic title={t.process.title} description={t.process.description}/>
</div>
</section> 

<div class="my-6">
    <div class="space-y-4">
        {
            t.process.steps.map((item) => {
                return (
                <Accordion
                    index= {item.index}
                    title={item.label}
                    description={item.content}
                />
                );
            })
        }
    </div>
</div>

<div class="relative flex flex-col items-center md:flex-row pt-6">
    <Topic title={t.deliverables.title} description={t.deliverables.description}/>
</div>



<div class="flex-row items-center py-5" id="team">
    <div class="grid grid-cols-1 sm:grid-cols-1 md:grid-cols-3 gap-6">
    {
    deliverables.map(({ title, description, name, profile} ) => (
    <div class="px-6 sm:px-8 py-8 bg-white rounded-[45px] shadow-card border border-zinc-900 flex flex-col gap-6 text-black">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 w-full">
            <div class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 rounded-full overflow-hidden bg-gray-100 flex-shrink-0">
                <img src={profile} alt="" class="w-full h-full object-cover" />
            </div>
            <div class="flex-col justify-start items-start gap-1 flex-1 text-center sm:text-start">
                <div class="text-xs sm:text-sm font-medium uppercase tracking-wider opacity-70">{title}</div>
                <div class="text-lg sm:text-xl font-medium leading-snug">{name}</div>
            </div>
           
        </div>
        <hr class="w-full border border-black"/>
        <p class="text-base font-light leading-7">{description}</p>
    </div>
    ))
    }
    </div>
</div>

<style>
  @media (max-width: 767px) {
    #team .grid {
      gap: 1rem;
    }
  }
</style>

</Container>